# Variáveis da função /api/dificuldade. Preencha os valores só no painel da Vercel
# (Settings → Environment Variables). Nunca commite valores reais.

# SECRETA – token permanente do usuário do sistema no Meta Business (WhatsApp Cloud API)
WHATSAPP_TOKEN=
# ID do número remetente (WhatsApp Manager → Configuração da API)
WHATSAPP_PHONE_NUMBER_ID=
# Número que recebe as mensagens, só dígitos com DDI e DDD
WHATSAPP_DESTINO=5511976505012
# Nome e idioma do modelo de mensagem aprovado pela Meta
WHATSAPP_TEMPLATE=nova_dificuldade
WHATSAPP_TEMPLATE_LANG=pt_BR
# Opcional: versão da Graph API
WHATSAPP_API_VERSION=v23.0

# SECRETA – chave secreta do widget Cloudflare Turnstile
TURNSTILE_SECRET_KEY=
